# eslint-plugin-react's published peer range still lags ESLint 10 (it caps at
# eslint@<=9.7), while this repo's dev tooling pins eslint@^10. The plugin works
# under flat config on ESLint 10; npm's strict peer resolver refuses the install
# regardless. legacy-peer-deps keeps `npm install` / `npm ci` working locally and
# in CI. This affects the harness dev/build install only — eslint* are
# devDependencies, so the published package's runtime deps are unchanged.
legacy-peer-deps=true
