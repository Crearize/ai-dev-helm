{
  "PreToolUse": [
    {
      "matcher": "^Bash$",
      "hooks": [
        {
          "type": "command",
          "command": "jq -r '.tool_input.command // \"\"' | grep -qE '(^|[;&|(])[[:space:]]*git[[:space:]]+(-C[[:space:]]+[^[:space:]]+[[:space:]]+)?push([[:space:];&|)]|$)' && { if [ ! -f .quality-check-passed ]; then echo '{\"decision\":\"block\",\"reason\":\"Quality check not passed. Run quality-check before pushing.\"}'; else rm -f .quality-check-passed; fi; } || true",
          "timeout": 10
        }
      ]
    }
  ]
}
