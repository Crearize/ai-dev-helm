# Codex user-level configuration (~/.codex/config.toml)
# Merged by `ai-dev-helm personal`. Existing values are preserved.
# Docs: https://developers.openai.com/codex/config-basic

model = "gpt-6-astra"
model_reasoning_effort = "high"

# Default policy: prompt only when needed
approval_policy = "on-request"

# Default sandbox: read-only at user level; per-project files can opt into workspace-write
sandbox_mode = "read-only"

# Codex CLI rejects the former TOML [[rules]] schema. Managed command safety
# is installed as supported .codex/rules/*.rules prefix rules.
[agents]
enabled = true
default_subagent_model = "gpt-5.6-terra"
default_subagent_reasoning_effort = "medium"
