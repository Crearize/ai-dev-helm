{
  "_comment": "Decision table for `ai-dev-helm hook-selftest`. Run against the hooks installed in a project. expect: deny | allow (owner-guard also: block - a Stop refusal, context - passed with a notice; reviewState: below | reached - the review-budget state of the branch the case runs on, quality 1/5 or 1/1 rounds).declaredAlso: a decision also accepted from a declared file (gate.script / reviewBudgetScript). Kept in sync with the hooks by lib/hook-selftest.test.js.",
  "quality-gate": [
    { "name": "push to main without a flag is gated", "command": "git push origin main", "expect": "deny" },
    { "name": "push of a feature branch is left alone", "command": "git push origin feat/x", "expect": "allow" },
    { "name": "refspec feature:main is gated", "command": "git push origin feat/x:main", "expect": "deny" },
    { "name": "HEAD:main is gated", "command": "git push origin HEAD:main", "expect": "deny" },
    { "name": "delete refspec :main is gated", "command": "git push origin :main", "expect": "deny" },
    { "name": "force push to main is gated", "command": "git push --force origin main", "expect": "deny" },
    { "name": "push --all is gated", "command": "git push --all origin", "expect": "deny" },
    { "name": "gh pr merge without a flag is gated", "command": "gh pr merge 12", "expect": "deny" },
    { "name": "git -C relocation is gated", "command": "git -C other push origin main", "expect": "deny" },
    { "name": "gated operation after && is gated", "command": "git push origin feat/x && gh pr merge 3", "expect": "deny" },
    { "name": "merge off main is left alone", "command": "git merge feat/y", "expect": "allow" },
    { "name": "ordinary commands are left alone", "command": "npm test", "expect": "allow" },
    { "name": "git status is left alone", "command": "git status", "expect": "allow" },
    { "name": "Monitor push to main is gated", "event": { "tool_name": "Monitor", "tool_input": { "command": "git push origin main", "description": "push", "timeout_ms": 60000 } }, "expect": "deny" },
    { "name": "Monitor with only a WebSocket is left alone", "event": { "tool_name": "Monitor", "tool_input": { "ws": { "url": "wss://example.com/events" }, "description": "events", "timeout_ms": 60000 } }, "expect": "allow" },
    { "name": "unreadable payload fails open", "raw": "not json", "expect": "allow", "declaredAlso": "deny" }
  ],
  "review-budget": [
    { "name": "Bash command is not a review", "event": { "tool_name": "Bash", "tool_input": { "command": "npm test" } }, "expect": "allow" },
    { "name": "ordinary implementer agent is not counted", "event": { "tool_name": "spawn_agent", "tool_input": { "task_name": "implementer", "message": "Do the task; no review." } }, "expect": "allow" },
    { "name": "unmarked review agent is denied (Agent)", "event": { "tool_name": "Agent", "tool_input": { "description": "コードレビュー", "subagent_type": "general-purpose", "prompt": "Review it." } }, "expect": "deny" },
    { "name": "unmarked reviewer is denied (spawn_agent)", "event": { "tool_name": "spawn_agent", "tool_input": { "task_name": "reviewer", "message": "Review it." } }, "expect": "deny" },
    { "name": "forged review token is denied", "event": { "tool_name": "spawn_agent", "tool_input": { "task_name": "reviewer", "message": "HELM_REVIEW:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:integrated-reviewer" } }, "expect": "deny" },
    { "name": "unmarked design review is denied", "event": { "tool_name": "Agent", "tool_input": { "description": "デザインレビュー", "subagent_type": "general-purpose", "prompt": "Review the slides." } }, "expect": "deny" }
  ],
  "owner-guard": [
    { "name": "a header without a class is denied", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "進め方はどれにしますか？", "header": "進め方", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "deny" },
    { "name": "a class alone passes", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "進め方はどれにしますか？", "header": "その他", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "allow" },
    { "name": "延長 below the quality limit is denied", "reviewState": "below", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "レビューを延長しますか？", "header": "延長:品質", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "deny" },
    { "name": "延長 at the quality limit passes", "reviewState": "reached", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "レビューを延長しますか？", "header": "延長", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "allow" },
    { "name": "延長:全員 below the limit passes", "reviewState": "below", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "全員のレビューを回しますか？", "header": "延長:全員", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "allow" },
    { "name": "延長 with no review state passes", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "レビューを延長しますか？", "header": "延長", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "allow" },
    { "name": "テスト passes with a notice", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "E2E を足しますか？", "header": "テスト：E2E", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "context" },
    { "name": "業務 without what was looked at is denied", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "単価はいくらですか？", "header": "業務:単価", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "deny" },
    { "name": "業務 with what was looked at passes", "event": { "tool_name": "AskUserQuestion", "tool_input": { "questions": [{ "question": "単価はいくらですか？（調べたもの: documents/pricing.md）", "header": "業務：単価", "multiSelect": false, "options": [{ "label": "A", "description": "a" }, { "label": "B", "description": "b" }] }] } }, "expect": "allow" },
    { "name": "Stop asking the user to run a command is blocked", "event": { "hook_event_name": "Stop", "stop_hook_active": false, "last_assistant_message": "次のコマンドを実行してください。" }, "expect": "block" },
    { "name": "Stop with [本人の操作] passes", "event": { "hook_event_name": "Stop", "stop_hook_active": false, "last_assistant_message": "[本人の操作] MFA の確認が要るため、ブラウザでログインしてください。" }, "expect": "allow" },
    { "name": "Stop with stop_hook_active passes", "event": { "hook_event_name": "Stop", "stop_hook_active": true, "last_assistant_message": "次のコマンドを実行してください。" }, "expect": "allow" },
    { "name": "Stop with a plain report passes", "event": { "hook_event_name": "Stop", "stop_hook_active": false, "last_assistant_message": "完了: テストを実行し、すべて通りました。" }, "expect": "allow" },
    { "name": "unreadable payload passes", "raw": "not json", "expect": "allow" }
  ]
}
